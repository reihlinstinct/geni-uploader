{
  "name": "oauth-bootstrap",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {"enabled": false},
  "durable_objects": {"bindings": [{"name":"OAUTH_STATES","class_name":"OneTimeState"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["OneTimeState"]}]
}
