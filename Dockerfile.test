# In-container test image (issue #607): the full offline suite runs inside
# the image environment, and building this file fails on a red test.
# Never published; the shipped Dockerfile and its provenance contract
# (issues #100/#49) are untouched by it.
#   docker build -f Dockerfile.test .
# Base pinned by multi-arch index digest (resolved 2026-10-25, same as Dockerfile).
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /src
# The sync and release-packaging tests shell out to git; python:*-slim ships none.
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY . .
RUN pip install --no-cache-dir -r requirements-dev.txt
RUN python -m pytest tests -q -rs
